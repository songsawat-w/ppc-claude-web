---
import type { LPTemplateConfig } from '@/lib/template-types';

interface Props {
  config: LPTemplateConfig;
}

const { config } = Astro.props;

const steps = [
  {
    title: 'Fill Out Form',
    description: 'Answer a few quick questions about your loan needs.',
    icon: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z',
  },
  {
    title: 'Get Matched',
    description: 'We connect you with lenders competing for your business.',
    icon: 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4',
  },
  {
    title: 'Choose Your Offer',
    description: 'Compare rates and terms, then pick the best deal for you.',
    icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
];
---

<section class="w-full max-w-lg mb-8">
  <h2 class="text-xl font-bold text-center text-gray-900 mb-6">How It Works</h2>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
    {steps.map((step) => (
      <div class="p-4">
        <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-blue-50 flex items-center justify-center">
          <svg class="w-6 h-6 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={step.icon} />
          </svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-800 mb-1">{step.title}</h3>
        <p class="text-xs text-gray-500">{step.description}</p>
      </div>
    ))}
  </div>
</section>
