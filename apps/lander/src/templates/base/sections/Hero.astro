---
import type { LPTemplateConfig } from '@/lib/template-types';

interface Props {
  config: LPTemplateConfig;
}

const { config } = Astro.props;
---

<section class="w-full max-w-lg text-center mb-8">
  <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3 leading-tight">
    Find Your Best {config.loanType === 'personal' ? 'Personal Loan' : 'Loan Offer'}
  </h1>
  <p class="text-base sm:text-lg text-gray-600 leading-relaxed">
    Compare offers from top lenders in seconds.
    <br class="hidden sm:inline" />
    No impact to your credit score.
  </p>
</section>

<section class="w-full max-w-md mb-8">
  <div class="flex justify-center gap-6 text-center text-sm text-gray-500">
    <div class="flex flex-col items-center">
      <svg class="w-6 h-6 mb-1 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
      </svg>
      <span>256-bit SSL</span>
    </div>
    <div class="flex flex-col items-center">
      <svg class="w-6 h-6 mb-1 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>2-Min Process</span>
    </div>
    <div class="flex flex-col items-center">
      <svg class="w-6 h-6 mb-1 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>No Credit Impact</span>
    </div>
  </div>
</section>
