---
import type { LPTemplateConfig } from '@/lib/template-types';

interface Props {
  config: LPTemplateConfig;
}

const { config } = Astro.props;

const faqs = [
  {
    question: 'Will this affect my credit score?',
    answer: 'No. Checking your rates uses a soft pull which does not impact your credit score.',
  },
  {
    question: 'How long does it take?',
    answer: 'Most users complete the form in under 2 minutes and receive offers instantly.',
  },
  {
    question: 'Is this service free?',
    answer: `Yes. ${config.brand} is completely free to use. We are compensated by lenders, not by you.`,
  },
  {
    question: 'What loan amounts are available?',
    answer: 'Loan amounts typically range from $500 to $35,000 depending on the lender and your qualifications.',
  },
];
---

<section class="w-full max-w-lg mb-8">
  <h2 class="text-xl font-bold text-center text-gray-900 mb-4">Frequently Asked Questions</h2>
  <div class="space-y-3">
    {faqs.map((faq) => (
      <details class="bg-white rounded-lg border border-gray-100 p-4">
        <summary class="text-sm font-semibold text-gray-800 cursor-pointer">{faq.question}</summary>
        <p class="mt-2 text-xs text-gray-500 leading-relaxed">{faq.answer}</p>
      </details>
    ))}
  </div>
</section>
