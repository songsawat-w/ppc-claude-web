---
import BaseTemplate from '../../templates/base/index.astro';
import type { LPTemplateConfig } from '../../lib/template-types';

if (!import.meta.env.DEV) {
  return Astro.redirect("/404");
}

const config: LPTemplateConfig = {
  brand: 'SandboxBrand',
  loanType: 'personal',
  colorId: 'ocean',
  fontId: 'inter',
  radius: 'rounded',
  sections: ['hero', 'cta', 'benefits', 'faq'],
};

---

<BaseTemplate config={config} />