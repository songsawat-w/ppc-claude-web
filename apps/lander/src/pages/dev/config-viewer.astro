---
if (!import.meta.env.DEV) {
  return Astro.redirect("/404");
}

const now = new Date().toISOString();
const mode = import.meta.env.DEV ? "DEV" : "PROD";
const envKeys = Object.keys(import.meta.env);
---

<html>
  <head>
    <title>Config Viewer</title>
    <meta charset="utf-8" />
    <style>
      body {
        margin: 0;
        font-family: monospace;
        background: #0f172a;
        color: #e2e8f0;
        padding: 40px;
      }
      h1 {
        font-family: system-ui;
      }
      .box {
        background: #1e293b;
        padding: 20px;
        border-radius: 12px;
        margin-top: 20px;
        overflow-x: auto;
      }
      ul {
        margin-top: 10px;
      }
      li {
        margin-bottom: 4px;
      }
      a {
        display: inline-block;
        margin-top: 30px;
        color: #38bdf8;
      }
    </style>
  </head>
  <body>
    <h1>Runtime Config Viewer</h1>

    <div class="box">
      <p><strong>Mode:</strong> {mode}</p>
      <p><strong>Timestamp:</strong> {now}</p>
      <p><strong>Current URL:</strong> {Astro.request.url}</p>
    </div>

    <h2>import.meta.env Keys</h2>
    <div class="box">
      <ul>
        {envKeys.map(key => (
          <li>{key}</li>
        ))}
      </ul>
    </div>

    <a href="/dev">← Back to Dev Panel</a>
  </body>
</html>