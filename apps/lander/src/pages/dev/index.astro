---
if (!import.meta.env.DEV) {
  return Astro.redirect("/404");
}

const tools = [
  { name: "Layout Preview", url: "/dev/layout-preview", desc: "Preview mock LayoutConfig and section order" },
  { name: "Config Viewer", url: "/dev/config-viewer", desc: "Inspect runtime environment and build mode" }
];
---

<html>
  <head>
    <title>Dev Control Panel</title>
    <meta charset="utf-8" />
    <style>
      body {
        margin: 0;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        background: #0f172a;
        color: #e2e8f0;
        padding: 40px;
      }
      h1 {
        margin-bottom: 30px;
      }
      .grid {
        display: grid;
        gap: 20px;
        max-width: 800px;
      }
      .card {
        background: #1e293b;
        padding: 20px;
        border-radius: 12px;
        transition: 0.2s ease;
      }
      .card:hover {
        background: #334155;
      }
      a {
        text-decoration: none;
        color: #38bdf8;
        font-weight: 600;
        font-size: 18px;
      }
      p {
        margin: 8px 0 0;
        font-size: 14px;
        color: #94a3b8;
      }
    </style>
  </head>
  <body>
    <h1>Internal Dev Control Panel</h1>
    <div class="grid">
      {tools.map(tool => (
        <div class="card">
          <a href={tool.url}>{tool.name}</a>
          <p>{tool.desc}</p>
        </div>
      ))}
    </div>
  </body>
</html>